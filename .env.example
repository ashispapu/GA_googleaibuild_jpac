# Copy to .env (never commit .env)

# ---- Auth ----
AUTH_MODE=local                      # local = backend login (dev, tests, demo fallback) | keycloak = on-prem SSO
JWT_SECRET=change-me                 # signs local access tokens AND approval tokens (both modes)
KEYCLOAK_URL=http://localhost:8080   # public URL = token issuer
KEYCLOAK_INTERNAL_URL=               # optional, e.g. http://keycloak:8080 from inside Docker (for public keys)
KEYCLOAK_REALM=plantguard
KEYCLOAK_CLIENT_ID=plantguard-web
KEYCLOAK_AUDIENCE=plantguard-api

# ---- Agents / LLM ----
# Provider, model, thinking, flows and every agent knob live in p2-agents/config/agents.ini (LiteLLM, Gemini by default).
GEMINI_API_KEY=                      # read via [llm] api_key_env; empty = backend streams the recorded run
AGENT_RUNTIME=config                 # config = agents.ini decides ([runtime] mode) | replay = recording only
PLANTGUARD_AGENTS_INI=               # optional: path to another agents.ini

# ---- Network (corporate proxy) ----
# Office network: uncomment these. Off the office network: comment them out again (or set LLM_PROXY=none if Windows
# still has the corporate proxy configured). Only outbound LLM calls use them; localhost is never proxied.
# HTTP_PROXY=http://127.0.0.1:3128
# HTTPS_PROXY=http://127.0.0.1:3128
# NO_PROXY=localhost,127.0.0.1
# LLM_PROXY=none                     # force a direct connection, ignoring the Windows proxy settings

# ---- Demo ----
OPEN_INCIDENT_ON_START=true          # starting scene warning/crisis opens INC-0042 at startup (false = presenter opens it)

# sim = live simulated plant (default), fixtures = scripted story/tests
DATA_MODE=sim
# SIM_RESET=1 wipes and reseeds the plant on start

# ---- Gemini on Vertex AI (Google Cloud; no API key, billed to the project) ----
# Uncomment all three; the agents then call vertex_ai/<model> instead of the Gemini API key.
# Sign in once on this machine:  gcloud auth application-default login
# (or GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json). Check with: cd p2-agents && python -m llm.check
# GOOGLE_GENAI_USE_ENTERPRISE=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
