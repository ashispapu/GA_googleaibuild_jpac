# Backend (C1). Mock and real backend use the same URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The incident the demo story uses (C9). Used only when no incident has been announced yet.
NEXT_PUBLIC_DEMO_INCIDENT_ID=INC-0042

# Auth.js (only needed when GET /auth/config says "keycloak")
AUTH_SECRET=change-me-with-openssl-rand-base64-32
AUTH_KEYCLOAK_ID=plantguard-web
AUTH_KEYCLOAK_SECRET=plantguard-web-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/plantguard
AUTH_TRUST_HOST=true
