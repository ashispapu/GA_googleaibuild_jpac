# PlantGuard on Google Cloud: copy to deploy/gcp/config.env and edit. Every script in deploy/gcp reads it.
PROJECT_ID=pessimist12-1205
REGION=asia-south1               # Cloud Run, Cloud SQL, Memorystore, Qdrant VM and Artifact Registry live here
ZONE=asia-south1-a               # Qdrant VM + its data disk
NAME=plantguard                  # prefix of every resource name
ENV=prod                         # prod | staging (also the Qdrant collection prefix: plantguard_<ENV>)
ALERT_EMAIL=ops@example.com      # monitoring alerts go here
PLANT_IDS=PLANT-A,PLANT-B        # one isolated Qdrant collection of repair history per plant
TZ_PLANT=UTC                     # time zone shown in the web app (IANA name, e.g. Asia/Kolkata)

# ---- sizes (production defaults; see the guide for the small/cheap variant) ----
SQL_TIER=db-custom-2-7680        # 2 vCPU, 7.5 GB
SQL_HA=REGIONAL                  # REGIONAL (automatic fail-over) | ZONAL
SQL_STORAGE_GB=50
REDIS_TIER=standard              # standard = replica + automatic fail-over | basic
REDIS_SIZE_GB=1
QDRANT_MACHINE=e2-standard-2
QDRANT_DISK_GB=50
QDRANT_IMAGE=qdrant/qdrant:v1.13.4
API_MIN=1
API_MAX=10
WORKER_MIN=1
WORKER_MAX=5
WORKER_CONCURRENCY=4             # analyses one worker instance runs at the same time
LLM_MODEL=gemini-2.5-flash       # Vertex AI model (agents.ini model = gemini/<this>)
VERTEX_LOCATION=global

# ---- network ranges (change only if they clash with your VPCs) ----
RUN_SUBNET_RANGE=10.20.0.0/24    # Cloud Run direct VPC egress
SVC_SUBNET_RANGE=10.20.4.0/24    # Qdrant VM
PSA_RANGE_PREFIX=16              # private services access (Cloud SQL + Memorystore)

# ---- image tag (07-build.sh sets it to the git commit when empty) ----
TAG=
