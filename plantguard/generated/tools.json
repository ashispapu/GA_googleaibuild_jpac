  "get_asset_health": {
    "agents": [
      "decision",
      "diagnosis",
      "monitor"
    ],
    "writes": false,
    "endpoint": "GET /ml/assets/{asset_id}/health",
    "schema": {
      "type": "function",
      "function": {
        "name": "get_asset_health",
        "description": "ML risk, RUL and top SHAP features for an asset",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "asset_id": {
              "title": "Asset Id",
              "type": "string"
            }
          },
          "required": [
            "asset_id"
          ],
          "title": "AssetArgs",
          "type": "object"
        }
      }
    }
  },
  "get_signals": {
    "agents": [
      "diagnosis",
      "monitor"
    ],
    "writes": false,
    "endpoint": "GET /ot/assets/{asset_id}/signals",
    "schema": {
      "type": "function",
      "function": {
        "name": "get_signals",
        "description": "Sensor time series for an asset",
        "parameters": {
          "$defs": {
            "Signal": {
              "enum": [
                "vibration_rms",
                "vibration_peak",
                "vibration_kurtosis",
                "bearing_temp",
                "motor_temp",
                "spindle_rpm",
                "motor_current",
                "power_kw"
              ],
              "title": "Signal",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "properties": {
            "asset_id": {
              "title": "Asset Id",
              "type": "string"
            },
            "signals": {
              "items": {
                "$ref": "#/$defs/Signal"
              },
              "title": "Signals",
              "type": "array"
            },
            "minutes": {
              "default": 360,
              "title": "Minutes",
              "type": "integer"
            }
          },
          "required": [
            "asset_id",
            "signals"
          ],
          "title": "SignalArgs",
          "type": "object"
        }
      }
    }
  },
