  "create_work_order": {
    "agents": [
      "executor"
    ],
    "writes": true,
    "endpoint": "POST /maintenance/work-orders",
    "schema": {
      "type": "function",
      "function": {
        "name": "create_work_order",
        "description": "Create maintenance work order",
        "parameters": {
          "$defs": {
            "PartUse": {
              "additionalProperties": false,
              "properties": {
                "sku": {
                  "examples": [
                    "SKF-6205"
                  ],
                  "pattern": "^[A-Z0-9]+-[A-Z0-9-]+$",
                  "title": "Sku",
                  "type": "string"
                },
                "quantity": {
                  "minimum": 1,
                  "title": "Quantity",
                  "type": "integer"
                }
              },
              "required": [
                "sku",
                "quantity"
              ],
              "title": "PartUse",
              "type": "object"
            },
            "WorkOrderType": {
              "enum": [
                "corrective",
                "preventive",
                "predictive"
              ],
              "title": "WorkOrderType",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "properties": {
            "asset_id": {
              "examples": [
                "EQ-3012"
              ],
              "pattern": "^EQ-\\d{4}$",
              "title": "Asset Id",
              "type": "string"
            },
            "type": {
              "$ref": "#/$defs/WorkOrderType"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "root_cause": {
              "title": "Root Cause",
              "type": "string"
            },
            "parts": {
              "items": {
                "$ref": "#/$defs/PartUse"
              },
              "title": "Parts",
              "type": "array"
            },
            "technician_id": {
              "examples": [
                "TECH-104"
              ],
              "pattern": "^TECH-\\d{3}$",
              "title": "Technician Id",
              "type": "string"
            },
            "planned_start": {
              "format": "date-time",
              "title": "Planned Start",
              "type": "string"
            },
            "duration_hours": {
              "exclusiveMinimum": 0,
              "title": "Duration Hours",
              "type": "number"
            },
            "incident_id": {
              "examples": [
                "INC-0042"
              ],
              "pattern": "^INC-\\d{4}$",
              "title": "Incident Id",
              "type": "string"
            },
            "approval_token": {
              "title": "Approval Token",
              "type": "string"
            }
          },
          "required": [
            "asset_id",
            "type",
            "title",
            "root_cause",
            "parts",
            "technician_id",
            "planned_start",
            "duration_hours",
            "incident_id",
            "approval_token"
          ],
          "title": "WorkOrderCreate",
          "type": "object"
        }
      }
    }
  },
  "create_stock_transfer": {
    "agents": [
      "executor"
    ],
    "writes": true,
    "endpoint": "POST /erp/stock-transfers",
    "schema": {
      "type": "function",
      "function": {
        "name": "create_stock_transfer",
        "description": "Move parts between plants",
        "parameters": {
          "$defs": {
            "TransferMode": {
              "enum": [
                "standard",
                "express"
              ],
              "title": "TransferMode",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "properties": {
            "sku": {
              "examples": [
                "SKF-6205"
              ],
              "pattern": "^[A-Z0-9]+-[A-Z0-9-]+$",
              "title": "Sku",
              "type": "string"
            },
            "from_plant": {
              "examples": [
                "PLANT-A"
              ],
              "pattern": "^PLANT-[A-Z]$",
              "title": "From Plant",
              "type": "string"
            },
            "to_plant": {
              "examples": [
                "PLANT-A"
              ],
              "pattern": "^PLANT-[A-Z]$",
              "title": "To Plant",
              "type": "string"
            },
            "quantity": {
              "minimum": 1,
              "title": "Quantity",
              "type": "integer"
            },
            "mode": {
              "$ref": "#/$defs/TransferMode"
            },
            "incident_id": {
              "examples": [
                "INC-0042"
              ],
              "pattern": "^INC-\\d{4}$",
              "title": "Incident Id",
              "type": "string"
            },
            "approval_token": {
              "title": "Approval Token",
              "type": "string"
            }
          },
          "required": [
            "sku",
            "from_plant",
            "to_plant",
            "quantity",
            "mode",
            "incident_id",
            "approval_token"
          ],
          "title": "StockTransferCreate",
          "type": "object"
        }
      }
    }
  }
